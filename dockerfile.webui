# syntax=docker/dockerfile:1
FROM node:20-alpine AS ui
WORKDIR /src/webui/frontend
COPY webui/frontend/package.json webui/frontend/package-lock.json ./
RUN npm ci
COPY webui/frontend/ ./
RUN npm run build

FROM golang:1.25.6-alpine AS builder
WORKDIR /src/webui
COPY webui/go.mod webui/go.sum ./
RUN go mod download
COPY webui/backend/ ./backend/
COPY webui/frontend/embed.go ./frontend/embed.go
COPY --from=ui /src/webui/frontend/dist ./frontend/dist
RUN CGO_ENABLED=0 go build -o /out/gickup-web ./backend

FROM golang:1.25.6-alpine AS gickup-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 go build -o /out/gickup .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /out/gickup-web ./gickup-web
COPY --from=gickup-builder /out/gickup ./gickup
